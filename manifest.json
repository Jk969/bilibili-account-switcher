{
  "manifest_version": 3,
  "name": "账号切换助手",
  "version": "1.2",
  "description": "支持多站点账号一键切换及账号名称修改",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "账号切换"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["floating.js"],
      "css": ["floating.css"],
      "run_at": "document_idle"
    }
  ]
}
